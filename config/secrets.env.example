# Copy to config/secrets.env and fill locally. Never commit real values.
# initialize.sh creates config/secrets.env with mode 600 if it is missing.

# Synthetic / OpenAI-compatible provider key (the endpoint URL is not a secret
# and lives in config/local.toml as synthetic_base_url):
# SYNTHETIC_API_KEY=sk-...

# Telegram bot token:
# METTACLAW_TELEGRAM_BOT_TOKEN=123456789:...

# Optional Tavily web search key. If set, (search "...") uses Tavily first and
# falls back to DuckDuckGo if Tavily is unavailable.
# TAVILY_API_KEY=tvly-...
