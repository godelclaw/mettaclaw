[Unit]
Description=Independent durable Telegram transport for %i
Requires=cetta-telegram@%i.socket
After=cetta-telegram@%i.socket network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/pettaclaw-%i
Environment=METTACLAW_INSTANCE=%i
EnvironmentFile=%h/.config/pettaclaw/%i-channel.env
ExecStart=/usr/bin/python3 %h/pettaclaw-%i/src/start_telegram_service.py --repo %h/pettaclaw-%i --state %S/cetta-telegram-%i --credential %d/bot-token
LoadCredential=bot-token:%h/.config/cetta-telegram-credentials/%i/token
StateDirectory=cetta-telegram-%i
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
Restart=on-failure
RestartPreventExitStatus=64 78
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
