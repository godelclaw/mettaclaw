[Unit]
Description=Independent PeTTaClaw execution gateway (%i)

[Service]
Type=simple
EnvironmentFile=%h/.config/pettaclaw/gateway-%i.env
ExecStart=/usr/bin/python3 -m execution_gateway --config %h/.config/pettaclaw/gateway-%i.json
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
