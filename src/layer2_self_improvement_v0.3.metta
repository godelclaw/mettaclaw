(= (ggb-now) now)
(= (ggb-evaluate-self $agent-id $curriculum) (assessment $agent-id $curriculum (ggb-now)))
(= (ggb-generate-candidates (assessment $agent-id $curriculum $ts)) (candidates $agent-id (change-spec add-capability $curriculum expand-curriculum-scope) (change-spec add-safety self-mod-gate strengthen-safety-gate)))
(= (ggb-propose-improvement $agent-id $change-spec) (proposal $agent-id $change-spec (proof-obligation $change-spec (ggb-now))))
(= (ggb-verify-improvement $proposal $evidence) (verification $proposal $evidence (ggb-check-proof $proposal $evidence)))
(= (ggb-check-proof $proposal $evidence) (ggb-utility-gate (ggb-utility-score $proposal $evidence)))
(= (ggb-utility-score $proposal $evidence) (+ (* 0.5 (ggb-ulc-score (proposal-change-spec $proposal))) (+ (* 0.3 (ggb-capability-score $evidence)) (* 0.2 (ggb-safety-score $evidence)))))
(= (ggb-ulc-score (change-spec add-care $target $desc)) 0.9)
(= (ggb-ulc-score (change-spec add-capability $target $desc)) 0.6)
(= (ggb-ulc-score (change-spec add-safety $target $desc)) 0.7)
(= (ggb-ulc-score (change-spec remove-protection $target $desc)) 0.1)
(= (ggb-ulc-score (change-spec $type $target $desc)) 0.3)
(= (ggb-capability-score $evidence) (if (> $evidence 0.5) 0.8 0.4))
(= (ggb-safety-score $evidence) (if (< $evidence 0.1) 0.9 0.1))
(= (ggb-utility-gate $score) (if (> $score 0.3) (pass $score) (fail $score)))
(= (proposal-change-spec (proposal $agent-id $change-spec $obligation)) $change-spec)
(= (ggb-apply-improvement (verification $proposal $evidence (pass $score)) $agent-id) (applied $agent-id (proposal-change-spec $proposal) $score))
(= (ggb-apply-improvement (verification $proposal $evidence (fail $score)) $agent-id) (rejected $agent-id (proposal-change-spec $proposal) $score))
(= (ggb-archive-version $agent-id $version-id $state) (archive $agent-id $version-id $state (ggb-now)))
(= (archive-agent (archive $agent-id $version-id $state $ts)) $agent-id)
(= (archive-version (archive $agent-id $version-id $state $ts)) $version-id)
(= (archive-state (archive $agent-id $version-id $state $ts)) $state)
(= (archive-ts (archive $agent-id $version-id $state $ts)) $ts)
(= (ggb-select-candidate (candidates $agent-id $first $rest)) $first)
(= (ggb-self-improve-tick $agent-id $iteration) (ggb-apply-improvement (ggb-verify-improvement (ggb-propose-improvement $agent-id (ggb-select-candidate (ggb-generate-candidates (ggb-evaluate-self $agent-id $iteration)))) 0.6) $agent-id))
